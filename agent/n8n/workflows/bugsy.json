        "url": "http://qdrant:6333/collections/personal_knowledge/points/search",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $('Embed Question').first().json.embedding, limit: 10, with_payload: true, filter: { must: [ { key: 'category', match: { value: 'jira-digests' } } ] } }) }}",
        "options": { "timeout": 30000 }
