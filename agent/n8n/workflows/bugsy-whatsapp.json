                "operation": "equals"
              }
            },
            {
              "id": "not-from-me",
              "leftValue": "={{ $('Evolution Webhook').item.json.body.data.key.fromMe }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "not-group",
              "leftValue": "={{ $('Evolution Webhook').item.json.body.data.key.remoteJid.endsWith('@g.us') }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "has-text",
              "leftValue": "={{ ($('Evolution Webhook').item.json.body.data.message && ($('Evolution Webhook').item.json.body.data.message.conversation || ($('Evolution Webhook').item.json.body.data.message.extendedTextMessage && $('Evolution Webhook').item.json.body.data.message.extendedTextMessage.text))) ? true : false }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
