              "name": "userText",
              "value": "={{ $('Evolution Webhook').item.json.body.data.message.conversation ? $('Evolution Webhook').item.json.body.data.message.conversation : ($('Evolution Webhook').item.json.body.data.message.extendedTextMessage ? $('Evolution Webhook').item.json.body.data.message.extendedTextMessage.text : '') }}",
