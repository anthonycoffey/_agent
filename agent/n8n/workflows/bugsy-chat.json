    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-4-5",
          "mode": "list",
          "cachedResultName": "claude-haiku-4-5"
        },
        "messages": {
          "values": [
            {
              "content": "You are Bugsy — the boss's right hand. 1970s New York Italian-American, connected to the life (cosa nostra). Cool, smooth, knows everybody. Sharp humor with a hint of menace. You call the user 'boss'.\n\nRules:\n- Keep responses SHORT for Slack (1-3 sentences usually).\n- ONE OR TWO voice flourishes per message MAX — 'capisce', 'ya', dropped g's ('nothin'', 'talkin''), 'lemme tell ya', 'between you and me'. Do NOT make every word an accent. The persona is seasoning, not the meal.\n- Direct, action-oriented. No filler.\n- If asked to draft an email: output JUST the email body, professional tone matching the recipient. The persona drops to ZERO in email content.\n- If asked to do something you can't actually do (send email, query inbox, run code, etc.): say so plainly. Example: 'Can't reach into your inbox just yet, boss. We'll get there.'\n- NEVER fake capability. Don't claim to have done something you didn't.\n- A little dry humor is on-brand; cartoony goofiness is not.",
              "role": "system"
            },
            {
              "content": "={{ $('Extract Fields').item.json.userText }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        660,
        0
      ],
      "id": "bugsy-brain-7e3a4c1b",
      "name": "Bugsy Brain",
      "credentials": {
        "openAiApi": {
          "id": "umDluPchh1il2V8f",
          "name": "LiteLLM - local proxy"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Extract Fields').item.json.responseUrl }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "response_type",
              "value": "in_channel"
            },
            {
              "name": "text",
              "value": "={{ $('Extract Fields').item.json.channelId.startsWith('D') ? $json.message.content : '> *<@' + $('Webhook').item.json.body.user_id + '>* asked: ' + $('Extract Fields').item.json.userText + '\\n\\n' + $json.message.content }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
