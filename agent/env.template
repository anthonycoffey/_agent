# Reference template. The real .env was generated by Terraform on first boot
# with random secrets. You only need to edit the lines at the bottom (API keys).

# ==== General ====
TAILSCALE_HOST=agent-vm.YOUR-TAILNET.ts.net
TZ=America/Chicago

# ==== Postgres ====
POSTGRES_USER=agent
POSTGRES_DB=agent
POSTGRES_PASSWORD=<generated-by-terraform>

# ==== Open WebUI / LiteLLM master key ====
WEBUI_SECRET_KEY=<generated-by-terraform>

# ==== n8n ====
N8N_ENCRYPTION_KEY=<generated-by-terraform>
N8N_USER_MANAGEMENT_JWT_SECRET=<generated-by-terraform>
N8N_HOST=n8n.coffey.codes

# ==== Cloudflare Tunnel ====
# From Cloudflare Zero Trust dashboard → Networks → Tunnels → <your tunnel>
CLOUDFLARE_TUNNEL_TOKEN=

# ==== SearXNG ====
# Generate once with: openssl rand -hex 32
SEARXNG_SECRET=<generate-once-with-openssl-rand>

# ==== Evolution API (WhatsApp gateway) ====
# Self-hosted FOSS — github.com/EvolutionAPI/evolution-api (AGPLv3).
# Generate once with: openssl rand -hex 32
EVOLUTION_API_KEY=<generate-once-with-openssl-rand>
# Hostname Evolution uses to build absolute URLs (QR pages, media links).
# Only needed publicly during initial QR pairing — keep it behind
# Cloudflare Access, or leave Evolution unexposed and pair via SSH tunnel.
EVOLUTION_HOST=evolution.coffey.codes


# ==== Langfuse ====
LANGFUSE_SECRET=<generated-by-terraform>
LANGFUSE_SALT=<generated-by-terraform>
NEXTAUTH_SECRET=<generated-by-terraform>

# ==== Model provider keys (you fill these in) ====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ==== MCP — Atlassian (Jira) ====
# Used by agent-mcp-atlassian container (sooperset/mcp-atlassian, SSE on :9000)
# to give Bugsy's AI Agent and n8n workflows live Jira read access.
# See docs/specs/active/SPEC-MCP-001-mcp-server-fleet-for-bugsy.md.
#
# Token creation: id.atlassian.com → Manage Account → Security → API tokens.
# Use a scoped read-only token; the container also runs with READ_ONLY_MODE=true
# as belt-and-suspenders against unintended writes.
ATLASSIAN_URL=https://ultrasoundai.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ==== MCP — GitHub ====
# Used by agent-mcp-github container (github/github-mcp-server, Streamable HTTP
# on :8082) to give Bugsy's AI Agent and n8n workflows live GitHub read access:
# PRs, issues, code search, repo metadata.
#
# Token creation: github.com → Settings → Developer settings → Personal access
# tokens → Fine-grained tokens → Generate new token.
#
# Defense-in-depth read-only:
#  1. Use a fine-grained PAT with READ scopes ONLY (Contents: Read, Pull
#     requests: Read, Issues: Read, Metadata: Read — no write anywhere).
#  2. The server is started with --read-only (rejects write tools).
#  3. n8n connects to the /readonly route which applies a withReadonly
#     middleware regardless of the flag above.
GITHUB_TOKEN_MCP=

# ==== MCP — Notion ====
# Used by agent-mcp-notion container (notionhq/notion-mcp-server, Streamable
# HTTP on :3000) to give Bugsy's AI Agent and n8n workflows live Notion read
# access: pages, blocks, databases/data sources, search.
#
# Two tokens involved:
#
# 1. NOTION_INTEGRATION_TOKEN — the Notion internal integration token. The
#    server uses this to call the Notion API on each tool invocation.
#    Create at https://www.notion.so/profile/integrations → New integration
#    (Internal). For read-only, set Capabilities → "Read content" only
#    (uncheck Update/Insert/Delete). Then visit each page/database/data-source
#    you want Bugsy to access and connect it to the integration (or use the
#    Access tab to grant a parent page).
NOTION_INTEGRATION_TOKEN=
#
# 2. NOTION_MCP_BEARER_TOKEN — bearer token for the MCP server's HTTP
#    transport. Authenticates n8n -> MCP server requests at /mcp. Separate
#    from Notion API auth; it's the gate on the MCP endpoint itself (same
#    pattern as github-mcp-server's bearer auth).
#    Generate once with: openssl rand -hex 32
NOTION_MCP_BEARER_TOKEN=<generate-once-with-openssl-rand-hex-32>
